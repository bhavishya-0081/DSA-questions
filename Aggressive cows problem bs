class Solution {
    boolean isValidAns(int[] stalls,int cows,int minDist ){
        int cowCount=1;
        int lastPos=stalls[0];
        for(int i=0;i<stalls.length;i++){
            if(stalls[i]-lastPos>=minDist){
                cowCount++;
                lastPos=stalls[i];
            }
            if(cowCount>=cows) return true;
        }
        return false;
        
        
        
        
        
        
        
    }
    public int aggressiveCows(int[] stalls, int cows) {
       //binary search
      Arrays.sort(stalls);
      int n=stalls.length;
      int low=0;
      int high=stalls[n-1]-stalls[0];
      int ans=-1;
      while(low<=high){
          int mid=low+(high-low)/2;
          if(isValidAns(stalls, cows, mid)){
              ans=mid;
              low=mid+1;
              
              
          }
          else{
              high=mid-1;
              
          }
      }
      return ans;
        
    }
}
