class Solution {
    public boolean isValidAns(int [] arr,int k ,int maxPages){
        int studentCount=1;
        int pages=0;
        for(int i=0;i<arr.length;i++){
            if(pages+arr[i]<=maxPages){
                pages=pages+arr[i];
                
            }
            else{
                studentCount++;
                if(studentCount>k|| arr[i]>maxPages){
                    return false;
                }
                else{
                    pages=0;
                    pages=pages+arr[i];
                }
            }
        }
        return true;
    }
    
 
    
    public int findPages(int[] arr, int k) {
        if(arr.length<k)return -1;
        // binary searach
        int n= arr.length;
        int low = 0;
        int sum=0;
        int ans=-1;
        for(int i=0;i<n;i++){
            sum+= arr[i];
            
        }
        int high=sum;
        while(low<=high){
            int mid=low+(high-low)/2;
            if(isValidAns(arr,k,mid)){
                ans=mid;
                high=mid-1;
            }
            else{
                low=mid+1;
            }
        }
        return ans;
        
        
    }
}
