class Solution {
    public int smallestDivisor(int[] nums, int threshold) {
        int low = 1;
        int high = 0;
        // high ki maximum value nikl lo

        for (int num=0;num<nums.length;num++ ) {
            high = Math.max(high,nums[num]);
        }
        // mid nikkl lo

        while (low < high) {
            int mid = low + (high - low) / 2;

            int sum = 0;

            for (int num : nums) {
                sum += (num + mid - 1) / mid;
            }

            if (sum <= threshold) {
                high = mid;
            } else {
                low = mid + 1;
            }
        }

        return low;
    }
}
