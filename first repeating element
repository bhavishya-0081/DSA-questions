class Solution {
    public int firstRepeated(int[] arr) {
        int ans= -1;
        HashMap<Integer,Integer> freq=new HashMap<>();
        
        for(int i=0; i<arr.length;i++){
            freq.put(arr[i],freq.getOrDefault(arr[i],0)+1);
            
        }
        for(int i=0;i<arr.length;i++){
            if(freq.get(arr[i])>1){
                ans=i+1;
                break;
                
                
            }
        }
        return ans;
        
        
    }
