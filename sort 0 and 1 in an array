class Solution {
    int[] segregate0and1(int[] arr) {
        int n= arr.length;
        int i=0;
        int j=n-1;
        while(i<j){
            
            if(arr[i]==1&&arr[j]==0){
                  arr[i]=0;
                  arr[j]=1;
            }
            if(arr[i]==0){
                i++;
            }
            if(arr[j]==1){
                j--;
            }
            
            
        }
        return arr;
       
    }
}
