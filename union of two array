import java.util.*;

class Solution {
    public static ArrayList<Integer> findUnion(int a[], int b[]) {
        ArrayList<Integer> union = new ArrayList<>();

        int n = a.length;
        int m = b.length;

        int i = 0, j = 0;

        // Process both arrays
        while (i < n && j < m) {

            // a[i] is smaller
            if (a[i] < b[j]) {
                if (union.isEmpty() || (union.get(union.size() - 1)!=a[i]) {
                    union.add(a[i]);
                }
                i++;
            }

            // b[j] is smaller
            else if (a[i] > b[j]) {
                if (union.isEmpty() || !union.get(union.size() - 1)!=b[j]) {
                    union.add(b[j]);
                }
                j++;
            }

            // Both are equal
            else {
                if (union.isEmpty() || !union.get(union.size() - 1)!=(a[i]) {
                    union.add(a[i]);
                }
                i++;
                j++;
            }
        }

        //  a array khtm hogyi so elements of b
        while (j < m) {
            if (union.isEmpty() || !union.get(union.size() - 1)!=(b[j]) {
                union.add(b[j]);
            }
            j++;
        }

        //  b array khtm hogyi so Remaining elements of a
        while (i < n) {
            if (union.isEmpty() || !union.get(union.size() - 1)!=(a[i]) {
                union.add(a[i]);
            }
            i++;
        }

        return union;
    }
}
